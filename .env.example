# Copy to .env.local and fill in. .env*.local is gitignored — never commit real keys.

# Google Maps (in-run map). One key, restricted to the app's bundle ids.
GOOGLE_MAPS_API_KEY=

# Supabase (cloud sync for signed-in users). Project Settings → API.
# Both values are meant to ship in the client: the publishable key grants
# nothing on its own, because every table is behind row-level security.
# Never put the service-role key here — it bypasses RLS.
# Leave both blank to run the app fully local-only; that is a supported mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
